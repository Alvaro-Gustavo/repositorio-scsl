# ============================================================
# REPOSITORIO SCSL - Configuracion
# Copie este archivo como .env (misma carpeta) y cambie TODAS las claves.
# El archivo .env nunca se comparte ni se sube a un repositorio.
# ============================================================

# Superusuario de PostgreSQL (solo para administrar la base)
BD_SUPERUSUARIO=postgres
BD_SUPERCLAVE=Cambie-Esta-Clave-Super-2026

# Puerto en este equipo (5433 para no chocar con un PostgreSQL ya instalado)
BD_PUERTO=5433

# Cuenta con la que se conectara la aplicacion (permisos limitados)
APP_BD_USUARIO=scsl_app
APP_BD_CLAVE=Cambie-Esta-Clave-App-2026

# Primer administrador del sistema (debe cambiar la clave al ingresar)
ADMIN_NOMBRE=Administrador del sistema
ADMIN_CORREO=admin@contraloria.gob.bo
ADMIN_CLAVE=Cambie-Esta-Clave-Admin-2026

# pgAdmin (opcional)
PGADMIN_CORREO=admin@scsl.local
PGADMIN_CLAVE=Cambie-Esta-Clave-PgAdmin
