# ============================================================
# REPOSITORIO SCSL - Configuracion
# Copie este archivo como .env (misma carpeta) y cambie TODAS las claves.
# El archivo .env nunca se comparte ni se sube a un repositorio.
# ============================================================

# Nombre de esta copia del proyecto. Solo cambielo si corre varias copias en el
# mismo equipo (cada una con otro PREFIJO, BD_PUERTO y WEB_PUERTO).
PREFIJO=scsl

# Superusuario de PostgreSQL (solo para administrar la base)
BD_SUPERUSUARIO=postgres
BD_SUPERCLAVE=Cambie-Esta-Clave-Super-2026

# Puerto en este equipo (5433 para no chocar con un PostgreSQL ya instalado)
BD_PUERTO=5433

# Cuenta con la que se conectara la aplicacion (permisos limitados)
APP_BD_USUARIO=scsl_app
APP_BD_CLAVE=Cambie-Esta-Clave-App-2026

# Primer administrador del sistema (debe cambiar la clave al ingresar)
ADMIN_NOMBRE=Administrador del sistema
ADMIN_CORREO=admin@contraloria.gob.bo
ADMIN_CLAVE=Cambie-Esta-Clave-Admin-2026

# Backend: clave para cifrar el segundo factor (2FA) de los usuarios.
# Use una cadena larga y aleatoria. Si la cambia, quien tenga 2FA debe volver a configurarlo.
APP_SECRETO=Cambie-Esta-Clave-Secreta-Larga-2026

# Correo para enviar los codigos de activacion y recuperacion.
# Si SMTP_HOST queda vacio, el codigo se muestra en: docker compose logs app
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
SMTP_TLS=si

# Interfaz web: http://IP-DEL-SERVIDOR:8080
WEB_PUERTO=8080
# real = usa el backend; simulado = datos de demostracion en el navegador (sin backend)
FRONTEND_MODO=real

# pgAdmin (opcional)
PGADMIN_CORREO=admin@contraloria.gob.bo
PGADMIN_CLAVE=Cambie-Esta-Clave-PgAdmin
