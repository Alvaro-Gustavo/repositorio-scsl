# Copie como .env para desarrollo.
# simulado = funciona sin backend, con datos de demostracion guardados en el navegador.
# real      = usa la API del backend en VITE_API_URL.
VITE_API_MODO=simulado
VITE_API_URL=/api

# Solo en desarrollo (npm run dev): direccion del backend al que se redirige /api
VITE_BACKEND_DESARROLLO=http://localhost:8000
